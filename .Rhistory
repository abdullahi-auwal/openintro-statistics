library(tidyverse)
library(openintro)
glimpse(arbuthnot)
arbuthnot$boy
arbuthnot$boys
arbuthnot$girls
ggplot(data = arbuthnot, aes(x = year, y = girls)) + geom_point
ggplot(data = arbuthnot, aes(x = year, y = girls)) + geom_point()
ggplot(data = arbuthnot, aes(x = year, y = girls))
ggplot(data = arbuthnot, aes(x = girls, y = year)) + geom_point()
ggplot(data = arbuthnot, aes(x = year, y = girls)) + geom_point()
library(tidyverse)
library(openintro)
ggplot(data = arbuthnot, x = girls, y = years)
ggplot(data = arbuthnot, aes(x = year, y = girls))
geom_point()
ggplot(data = arbuthnot, aes(x = year, y = girls)) + geom_point
ggplot(data = arbuthnot, aes(x = year, y = girls)) + geom_point()
ggplot(data = arbuthnot, aes(x = year, y = girls)) + geom_line()
?ggplot
arbuthnot$boys
arbuthnot$boys + arbuthnot$girls
